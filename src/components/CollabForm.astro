---
import { useTranslations, CONTACT, type Lang } from "../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const types = [
  t("collab.type.fashion"), t("collab.type.product"), t("collab.type.video"),
  t("collab.type.campaign"), t("collab.type.partnership"), t("collab.type.other"),
];
const budgets = ["< 1.000 €", "1.000 – 3.000 €", "3.000 – 10.000 €", "> 10.000 €"];
---

<section class="cf section">
  <div class="wrap wrap--wide cf__layout">
  <form class="cf__form" id="collab-form" data-wa={CONTACT.whatsapp}
    data-intro={lang === "es" ? "Nueva colaboración desde la web" : "New collaboration from the site"}>
    <div class="cf__row">
      <label class="cf__field">
        <span>{t("collab.form.name")}</span>
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label class="cf__field">
        <span>{t("collab.form.brand")}</span>
        <input type="text" name="brand" required />
      </label>
    </div>

    <div class="cf__row">
      <label class="cf__field">
        <span>{t("collab.form.email")}</span>
        <input type="email" name="email" autocomplete="email" />
      </label>
      <label class="cf__field">
        <span>{t("collab.form.type")}</span>
        <select name="type">
          {types.map((x) => <option value={x}>{x}</option>)}
        </select>
      </label>
    </div>

    <label class="cf__field">
      <span>{t("collab.form.budget")}</span>
      <select name="budget">
        <option value="">{t("collab.budget.pick")}</option>
        {budgets.map((x) => <option value={x}>{x}</option>)}
      </select>
    </label>

    <label class="cf__field">
      <span>{t("collab.form.message")}</span>
      <textarea name="message" rows="5" required></textarea>
    </label>

    <div class="cf__actions">
      <button type="submit" class="btn btn--dark cf__send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.821 11.821 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.738-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        {t("collab.form.send")}
      </button>
      <p class="cf__note">{t("collab.form.note")}</p>
    </div>
  </form>

    <aside class="cf__visual" aria-hidden="true">
      <img src="/img/collab-side.jpg" alt="" loading="lazy" />
    </aside>
  </div>
</section>

<style>
  .cf { background: var(--bg); }
  .cf__layout { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .cf__visual { position: sticky; top: 6rem; aspect-ratio: 4/5; overflow: hidden; border: 1px solid var(--line); filter: grayscale(1); transition: filter 0.6s var(--ease); }
  .cf__visual:hover { filter: grayscale(0); }
  .cf__visual img { width: 100%; height: 100%; object-fit: cover; }
  .cf__form { display: grid; gap: clamp(1.4rem, 2.5vw, 2rem); }
  .cf__row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.4rem, 2.5vw, 2rem); }
  .cf__field { display: grid; gap: 0.6rem; }
  .cf__field > span { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .cf__field input, .cf__field select, .cf__field textarea {
    font-family: inherit; font-size: 1rem; color: var(--ink); background: transparent;
    border: 0; border-bottom: 1px solid var(--line-2); padding: 0.7rem 0; width: 100%;
    border-radius: 0; transition: border-color 0.3s var(--ease);
  }
  .cf__field textarea { resize: vertical; }
  .cf__field input:focus, .cf__field select:focus, .cf__field textarea:focus { outline: none; border-color: var(--ink); }
  .cf__actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .cf__note { font-size: 0.82rem; color: var(--muted); margin: 0; max-width: 34ch; }
  @media (max-width: 900px) { .cf__layout { grid-template-columns: 1fr; } .cf__visual { display: none; } }
  @media (max-width: 620px) { .cf__row { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById("collab-form") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const wa = form.dataset.wa;
    const intro = form.dataset.intro || "";
    const f = new FormData(form);
    const L = document.documentElement.lang === "es"
      ? { name: "Nombre", brand: "Marca", email: "Email", type: "Proyecto", budget: "Presupuesto", msg: "Mensaje" }
      : { name: "Name", brand: "Brand", email: "Email", type: "Project", budget: "Budget", msg: "Message" };
    const lines = [
      "*" + intro + "*",
      L.name + ": " + (f.get("name") || ""),
      L.brand + ": " + (f.get("brand") || ""),
      L.email + ": " + (f.get("email") || "—"),
      L.type + ": " + (f.get("type") || ""),
      L.budget + ": " + (f.get("budget") || "—"),
      "",
      L.msg + ": " + (f.get("message") || ""),
    ];
    const url = "https://wa.me/" + wa + "?text=" + encodeURIComponent(lines.join("\n"));
    window.open(url, "_blank", "noopener");
  });
</script>
