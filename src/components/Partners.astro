---
import { useTranslations, type Lang } from "../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const partners = [
  { n: "01", name: "Magnific", body: t("partners.magnific.body"), url: "https://magnific.ai", img: "/img/sunglasses.webp" },
  { n: "02", name: "Dreamina AI", body: t("partners.dreamina.body"), url: "https://dreamina.capcut.com", img: "/img/rooftop.webp" },
  { n: "03", name: "Higgsfield", body: t("partners.higgsfield.body"), url: "https://higgsfield.ai", img: "/img/carwash.webp" },
];
---

<section class="pt">
  <div class="wrap pt__head">
    <span class="eyebrow pt__eyebrow">{t("partners.eyebrow")}</span>
    <h2 class="h-lg pt__title">{t("partners.title")}</h2>
    <p class="pt__sub">{t("partners.sub")}</p>
  </div>

  <div class="wrap wrap--wide pt__grid">
    {partners.map((p) => (
      <a class="pt__tile" href={p.url} target="_blank" rel="noopener" data-reveal>
        <img class="pt__img" src={p.img} alt="" loading="lazy" />
        <div class="pt__scrim"></div>
        <div class="pt__top">
          <span class="pt__role">{t("partners.role")}</span>
          <span class="pt__n">{p.n}</span>
        </div>
        <div class="pt__content">
          <h3 class="pt__name">{p.name}</h3>
          <p class="pt__body">{p.body}</p>
          <span class="pt__visit">{t("partners.visit")} <span class="arrow">↗</span></span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .pt { background: var(--ink); color: #fff; padding-block: clamp(4.5rem, 9vw, 8rem); }
  .pt__head { max-width: 54ch; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .pt__eyebrow { color: #fff; }
  .pt__eyebrow::before { background: var(--warm, #e7c9a9); }
  .pt__title { margin: 1rem 0 1rem; }
  .pt__sub { color: rgba(255,255,255,.7); font-size: clamp(1.02rem,1rem+0.3vw,1.2rem); margin: 0; }

  .pt__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.8rem, 1.6vw, 1.4rem); }
  .pt__tile {
    position: relative; display: flex; flex-direction: column; justify-content: flex-end;
    min-height: clamp(420px, 52vw, 620px); overflow: hidden;
    padding: clamp(1.4rem, 2vw, 2rem); color: #fff;
    border: 1px solid rgba(255,255,255,.14);
  }
  .pt__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.05); transition: transform 1.1s var(--ease), filter 0.6s var(--ease);
  }
  .pt__tile:hover .pt__img { transform: scale(1.05); filter: grayscale(0) contrast(1); }
  .pt__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,.35) 0%, rgba(10,10,10,.05) 35%, rgba(10,10,10,.85) 100%); }

  .pt__top { position: absolute; top: clamp(1.2rem,2vw,1.8rem); left: clamp(1.2rem,2vw,1.8rem); right: clamp(1.2rem,2vw,1.8rem); z-index: 2; display: flex; align-items: center; justify-content: space-between; }
  .pt__role { font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; border: 1px solid rgba(255,255,255,.6); padding: 0.4em 0.8em; backdrop-filter: blur(4px); }
  .pt__n { font-family: var(--font); font-size: 0.72rem; letter-spacing: 0.16em; color: rgba(255,255,255,.8); }

  .pt__content { position: relative; z-index: 2; }
  .pt__name { font-family: var(--font-display); font-size: clamp(2rem, 2.8vw, 3rem); margin: 0 0 0.7rem; }
  .pt__body { color: rgba(255,255,255,.82); font-size: 0.95rem; margin: 0 0 1.2rem; max-width: 34ch; }
  .pt__visit { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; display: inline-flex; align-items: center; gap: 0.5em; }
  .pt__visit .arrow { transition: transform 0.4s var(--ease); }
  .pt__tile:hover .pt__visit .arrow { transform: translate(3px, -3px); }

  @media (max-width: 820px) { .pt__grid { grid-template-columns: 1fr; } .pt__tile { min-height: 400px; } }
</style>
