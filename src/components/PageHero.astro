---
interface Props { kicker: string; title: string; sub?: string; img: string }
const { kicker, title, sub, img } = Astro.props;
---

<section class="ph">
  <div class="ph__bg" aria-hidden="true">
    <img src={img} alt="" fetchpriority="high" />
    <div class="ph__scrim"></div>
  </div>
  <div class="wrap wrap--wide ph__inner">
    <span class="eyebrow ph__eyebrow" data-reveal>{kicker}</span>
    <h1 class="h-xl ph__title" data-reveal style="transition-delay:.05s">{title}</h1>
    {sub && <p class="ph__sub" data-reveal style="transition-delay:.1s">{sub}</p>}
  </div>
</section>

<style>
  .ph { position: relative; min-height: clamp(460px, 68vh, 720px); display: flex; align-items: flex-end; padding-block: 8rem clamp(2.5rem,5vw,4rem); overflow: hidden; color: #fff; }
  .ph__bg { position: absolute; inset: 0; z-index: 0; background: var(--ink); }
  .ph__bg img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .ph__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,.5) 0%, rgba(10,10,10,.15) 40%, rgba(10,10,10,.8) 100%); }
  .ph__inner { position: relative; z-index: 2; width: 100%; max-width: 62rem; }
  .ph__eyebrow { color: #fff; }
  .ph__eyebrow::before { background: #fff; }
  .ph__title { margin-top: 1.4rem; max-width: 18ch; }
  .ph__sub { margin-top: 1.4rem; max-width: 54ch; font-size: clamp(1.05rem,1rem+0.4vw,1.3rem); color: rgba(255,255,255,.88); }
</style>
