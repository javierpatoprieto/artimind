---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import CollabForm from "../../components/CollabForm.astro";
import Partners from "../../components/Partners.astro";
import { useTranslations } from "../../i18n/ui";
const lang = "es" as const;
const t = useTranslations(lang);
---

<Layout
  lang={lang}
  page="collab"
  title="Colabora — ArtiMindArt | Marcas, agencias y plataformas"
  description="¿Tu marca quiere crear conmigo? Partner de Magnific, Dreamina AI y Higgsfield. Cuéntame tu proyecto y te respondo el mismo día."
>
  <PageHero kicker={t("collab.eyebrow")} title={t("collab.title")} sub={t("collab.sub")} img="/img/collab-hero.webp" />
  <CollabForm lang={lang} />
  <Partners lang={lang} />
</Layout>
