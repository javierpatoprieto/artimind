---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CollabForm from "../components/CollabForm.astro";
import Partners from "../components/Partners.astro";
import { useTranslations } from "../i18n/ui";
const lang = "en" as const;
const t = useTranslations(lang);
---

<Layout
  lang={lang}
  page="collab"
  title="Collaborate — ArtiMindArt | Brands, agencies and platforms"
  description="Does your brand want to create with me? Partner of Magnific, Dreamina AI and Higgsfield. Tell me your project and I reply the same day."
>
  <PageHero kicker={t("collab.eyebrow")} title={t("collab.title")} sub={t("collab.sub")} img="/img/collab-hero.webp" />
  <CollabForm lang={lang} />
  <Partners lang={lang} />
</Layout>
